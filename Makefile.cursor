CC = cc
CFLAGS = -std=c89 -O2 -Wall -Wextra -Werror -Iinclude
.PHONY: test

test: tests/exes/cursor-test
	./tests/exes/cursor-test

tests/exes/cursor-test: tests/test_cursor.c common/rg_cursor.c common/rgfx.c include/rg_cursor.h | tests/exes
	$(CC) $(CFLAGS) common/rgfx.c common/rg_cursor.c tests/test_cursor.c -o $@

tests/exes:
	mkdir -p $@
