CC ?= cc
CFLAGS = -std=c89 -O2 -Wall -Wextra -Werror -Iinclude
.PHONY: test clean
win31-screen-test: common/rgfx.c common/rg_gdi_rop.c common/rg_gdi_blit.c common/rg_win31_screen.c tests/test_win31_screen.c
	$(CC) $(CFLAGS) common/rgfx.c common/rg_gdi_rop.c common/rg_gdi_blit.c common/rg_win31_screen.c tests/test_win31_screen.c -o $@
test: win31-screen-test
	./win31-screen-test
clean:
	rm -f win31-screen-test
