CC ?= cc
CFLAGS = -std=c89 -O2 -Wall -Wextra -Werror -Iinclude
.PHONY: test clean
tests/exes/blit-gdi-test: tests/test_gdi_blit.c common/rgfx.c common/rg_gdi_rop.c common/rg_gdi_blit.c | tests/exes
	$(CC) $(CFLAGS) common/rgfx.c common/rg_gdi_rop.c common/rg_gdi_blit.c tests/test_gdi_blit.c -o $@
test: tests/exes/blit-gdi-test
	./tests/exes/blit-gdi-test
clean:
	rm -f tests/exes/blit-gdi-test

tests/exes:
	mkdir -p $@
