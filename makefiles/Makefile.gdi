CC = cc
CFLAGS = -std=c89 -O2 -Wall -Wextra -Werror -Iinclude
.PHONY: test clean

tests/exes/gdi-rop-test: common/rg_gdi_rop.c tests/test_gdi_rop.c include/rg_gdi_rop.h include/rgfx.h | tests/exes
	$(CC) $(CFLAGS) common/rg_gdi_rop.c tests/test_gdi_rop.c -o $@

test: tests/exes/gdi-rop-test
	./tests/exes/gdi-rop-test

clean:
	rm -f tests/exes/gdi-rop-test

tests/exes:
	mkdir -p $@
