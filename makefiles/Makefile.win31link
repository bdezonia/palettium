.PHONY: test win16 clean

test: tests/exes/win31-pixel-test tests/exes/win31-palette-test tests/exes/win31-objects-test tests/exes/win31-lines-test tests/exes/win31-mem-test
	$(MAKE) -f makefiles/Makefile.win31text test
	./tests/exes/win31-pixel-test
	./tests/exes/win31-palette-test
	./tests/exes/win31-objects-test
	./tests/exes/win31-lines-test
	./tests/exes/win31-mem-test
	python3 tests/test_win31_exportcheck.py

tests/exes/win31-pixel-test: tests/test_win31_pixel.c windows/win31/pal_screen_ddi.c windows/win31/pal_pdevice.c windows/win31/pal_gdiinfo.c common/rgfx.c common/rg_gdi_blit.c common/rg_gdi_rop.c common/rg_win31_screen.c | tests/exes
	$(CC) -std=c89 -O2 -Wall -Wextra -Werror -Iinclude -Iwindows/win31 common/rgfx.c common/rg_gdi_rop.c common/rg_gdi_blit.c common/rg_win31_screen.c windows/win31/pal_gdiinfo.c windows/win31/pal_pdevice.c windows/win31/pal_screen_ddi.c tests/test_win31_pixel.c -o $@

tests/exes/win31-palette-test: tests/test_win31_palette.c common/rg_palette.c common/rgfx.c include/rg_palette.h | tests/exes
	$(CC) -std=c89 -O2 -Wall -Wextra -Werror -Iinclude common/rgfx.c common/rg_palette.c tests/test_win31_palette.c -o $@

tests/exes/win31-objects-test: tests/test_win31_objects.c common/rg_objects.c common/rg_gdi_output.c common/rg_gdi_rop.c common/rg_palette.c common/rgfx.c windows/win31/pal_objects.c | tests/exes
	$(CC) -std=c89 -O2 -Wall -Wextra -Werror -Iinclude -Iwindows/win31 common/rgfx.c common/rg_gdi_rop.c common/rg_palette.c common/rg_objects.c common/rg_gdi_output.c windows/win31/pal_objects.c tests/test_win31_objects.c -o $@

tests/exes/win31-lines-test: tests/test_win31_lines.c common/rg_objects.c common/rg_gdi_output.c common/rg_gdi_rop.c common/rg_palette.c common/rgfx.c | tests/exes
	$(CC) -std=c89 -O2 -Wall -Wextra -Werror -Iinclude common/rgfx.c common/rg_gdi_rop.c common/rg_palette.c common/rg_objects.c common/rg_gdi_output.c tests/test_win31_lines.c -o $@

tests/exes/win31-mem-test: tests/test_win31_mem.c windows/win31/pal_bitmap.c windows/win31/pal_bitmap_device.c common/rg_gdi_blit.c common/rg_gdi_output.c common/rg_gdi_rop.c common/rg_objects.c common/rg_palette.c common/rgfx.c | tests/exes
	$(CC) -std=c89 -O2 -Wall -Wextra -Werror -Iinclude -Iwindows/win31 common/rgfx.c common/rg_gdi_blit.c common/rg_gdi_output.c common/rg_gdi_rop.c common/rg_objects.c common/rg_palette.c windows/win31/pal_gdiinfo.c windows/win31/pal_pdevice.c windows/win31/pal_bitmap.c windows/win31/pal_bitmap_device.c tests/test_win31_mem.c -o $@

tests/exes:
	mkdir -p $@

win16:
	sh windows/win31/build-palddi.sh

clean:
	rm -f tests/exes/PALSTAGE.DRV tests/exes/PALSTAGE.exports.txt tests/exes/win31-pixel-test tests/exes/win31-palette-test tests/exes/win31-objects-test tests/exes/win31-lines-test tests/exes/win31-mem-test
