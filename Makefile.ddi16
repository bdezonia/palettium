# Palettium v0016 DDI routing test; additive, no replacement of Makefile.
CC ?= cc
CFLAGS = -std=c89 -O2 -Wall -Wextra -Werror
INC = -Iinclude -Iwindows/win31
SRC = common/rgfx.c common/rg_gdi_rop.c common/rg_gdi_blit.c \
      common/rg_win31_screen.c windows/win31/pal_gdiinfo.c \
      windows/win31/pal_pdevice.c windows/win31/pal_screen_ddi.c \
      tests/test_win31_ddi_bridge.c
.PHONY: test clean
test: ddi16-test
	./ddi16-test
ddi16-test: $(SRC) windows/win31/pal_screen_ddi.h
	$(CC) $(CFLAGS) $(INC) $(SRC) -o $@
clean:
	rm -f ddi16-test
