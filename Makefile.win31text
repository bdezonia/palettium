CC = cc
CFLAGS = -std=c89 -O2 -Wall -Wextra -Werror -Iinclude -Iwindows/win31
.PHONY: test

test: tests/exes/win31-text-test tests/exes/win31-text-entry-test tests/exes/win31-text-entry-trace-test
	./tests/exes/win31-text-test
	./tests/exes/win31-text-entry-test
	./tests/exes/win31-text-entry-trace-test
	$(CC) -std=c89 -fsyntax-only -Werror -Itests/win16_stubs -Iinclude -Iwindows/win31 -Ihardware/tseng/et4000ax -include tests/win16_stubs/driver_syntax.h windows/win31/palddi.c

tests/exes/win31-text-test: tests/test_win31_text.c common/rg_gdi_text.c windows/win31/pal_font16.c common/rgfx.c | tests/exes
	$(CC) $(CFLAGS) common/rgfx.c common/rg_gdi_text.c windows/win31/pal_font16.c tests/test_win31_text.c -o $@

tests/exes:
	mkdir -p $@

# Only text export sections are retained when linking this host simulation;
# Win16 far pointers and the real Watcom calling convention are NOT tested.
tests/exes/win31-text-entry-test: tests/test_win31_text_entry.c common/rg_palette.c windows/win31/palddi.c common/rg_gdi_text.c windows/win31/pal_font16.c common/rg_cursor.c windows/win31/pal_cursor16.c common/rgfx.c | tests/exes
	$(CC) $(CFLAGS) -ffunction-sections -fdata-sections -Itests/win16_stubs -Ihardware/tseng/et4000ax common/rgfx.c common/rg_palette.c common/rg_gdi_text.c common/rg_gdi_blit.c common/rg_cursor.c windows/win31/pal_cursor16.c windows/win31/pal_font16.c tests/test_win31_text_entry.c -Wl,--gc-sections -o $@

tests/exes/win31-text-entry-trace-test: tests/test_win31_text_entry.c common/rg_palette.c windows/win31/palddi.c common/rg_gdi_text.c windows/win31/pal_font16.c common/rg_cursor.c windows/win31/pal_cursor16.c common/rgfx.c | tests/exes
	$(CC) $(CFLAGS) -DPAL_WIN31_BOOTTRACE -ffunction-sections -fdata-sections -Itests/win16_stubs -Ihardware/tseng/et4000ax common/rgfx.c common/rg_palette.c common/rg_gdi_text.c common/rg_gdi_blit.c common/rg_cursor.c windows/win31/pal_cursor16.c windows/win31/pal_font16.c tests/test_win31_text_entry.c -Wl,--gc-sections -o $@
