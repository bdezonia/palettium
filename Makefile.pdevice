# Standalone Win31 PDEVICE candidate tests; does not modify existing Makefile.
CC ?= cc
CFLAGS ?= -std=c89 -O2 -Wall -Wextra -Werror
.PHONY: test clean
test: pdevice-test
	./pdevice-test
pdevice-test: windows/win31/pal_pdevice.c windows/win31/pal_pdevice.h windows/win31/pal_gdiinfo.c windows/win31/pal_gdiinfo.h tests/test_win31_pdevice.c
	$(CC) $(CFLAGS) -Iwindows/win31 windows/win31/pal_gdiinfo.c windows/win31/pal_pdevice.c tests/test_win31_pdevice.c -o $@
clean:
	rm -f pdevice-test
