CC ?= cc
CFLAGS = -std=c89 -O2 -Wall -Wextra -Werror -Iinclude
.PHONY: test clean
blit-gdi-test: tests/test_gdi_blit.c common/rgfx.c common/rg_gdi_rop.c common/rg_gdi_blit.c
	$(CC) $(CFLAGS) common/rgfx.c common/rg_gdi_rop.c common/rg_gdi_blit.c tests/test_gdi_blit.c -o $@
test: blit-gdi-test
	./blit-gdi-test
clean:
	rm -f blit-gdi-test
