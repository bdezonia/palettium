# Palettium v0020: Win31 GDI far pointer boundary regression
CC ?= cc
CFLAGS = -std=c89 -O2 -Wall -Wextra -Werror
INCS = -Iinclude -Iwindows/win31
SRC = common/rgfx.c common/rg_hardware.c common/rg_gdi_rop.c \
      common/rg_gdi_blit.c common/rg_win31_screen.c \
      windows/win31/pal_gdiinfo.c windows/win31/pal_pdevice.c \
      windows/win31/pal_screen_ddi.c windows/win31/pal_screen_host.c \
      windows/win31/pal_ddl_blit.c tests/test_win31_farblt.c
.PHONY: test clean
test: tests/exes/far20-test
	./tests/exes/far20-test
tests/exes/far20-test: $(SRC) windows/win31/pal_ddl_blit.h | tests/exes
	$(CC) $(CFLAGS) $(INCS) $(SRC) -o $@
tests/exes:
	mkdir -p $@
clean:
	rm -f tests/exes/far20-test
